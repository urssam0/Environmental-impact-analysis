            <column datatype='integer' name='[Water Consumption (liters)]' role='measure' type='quantitative' />
            <column-instance column='[Product Type]' derivation='None' name='[none:Product Type:nk]' pivot='key' type='nominal' />
            <column-instance column='[Water Consumption (liters)]' derivation='Sum' name='[sum:Water Consumption (liters):qk]' pivot='key' type='quantitative' />
